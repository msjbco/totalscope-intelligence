{
  "name": "totalscope-intelligence",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "import:q2-2026": "node scripts/run-q2-2026-import.mjs import",
    "inspect:q2-2026": "node scripts/run-q2-2026-import.mjs inspect",
    "validate:q2-2026-import": "node scripts/run-q2-2026-import.mjs validate --json-output .artifacts/q2-2026-import-validation.json",
    "validate:c3-fixtures": "node scripts/c3/validate-fixtures.mjs",
    "inspect:c3-import": "node scripts/c3/ingest-fixtures.mjs inspect",
    "import:c3-fixtures": "node scripts/c3/ingest-fixtures.mjs import",
    "validate:c3-import": "node scripts/c3/ingest-fixtures.mjs validate",
    "test": "node --test tests/*.test.mjs",
    "test:c2-db": "node tests/c2-database-security.mjs",
    "test:c3-db": "node tests/c3-database-security.mjs",
    "test:weather": "node --test tests/weather-*.test.mjs",
    "test:weather-db": "node tests/weather-database-security.mjs",
    "test:weather-hosted": "node tests/weather-hosted-security.mjs --confirm-staging",
    "test:weather-refresh-db": "node tests/weather-refresh-database.mjs",
    "test:weather-zcta-db": "node tests/weather-zcta-database.mjs",
    "test:client-data": "node --test tests/client-company-import.test.mjs",
    "test:client-db": "node tests/client-company-database.mjs",
    "test:geocoding": "node --test tests/geocodio-geocoding.test.mjs",
    "test:geocoding-db": "node tests/client-geocoding-database.mjs",
    "trial:geocodio": "node scripts/geocoding/run-geocodio-trial.mjs",
    "refresh:nws-staging": "node scripts/weather/refresh-nws-staging.mjs",
    "validate:nws-refresh-staging": "node scripts/weather/validate-refresh-staging.mjs",
    "import:census-zctas": "node scripts/weather/import-census-zctas.mjs all",
    "validate:ci": "npm test && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "next": "15.5.21",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.21",
    "shapefile": "^0.6.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
